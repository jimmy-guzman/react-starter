    "jiti": "2.7.0",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "msw": "2.15.0",
    "oxfmt": "0.60.0",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
